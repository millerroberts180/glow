# Glow's identity for builds, read by scripts/bundle.sh and scripts/release.sh. This is the one place
# it is set: bundle.sh stamps it on the bundle's copy of Info.plist, and release.sh builds through
# bundle.sh, so local and release builds match. Resources/Info.plist carries the same values only so it
# is a complete plist on its own; every build overwrites them from here. Shell syntax: both scripts
# source this file.

# The bundle ID is the identity macOS knows Glow by on every Mac that runs it. Changing it gives Glow a
# new one: anyone already running Glow grants Accessibility again (the brightness keys), turns Open at
# login on again, and starts with default settings, because Glow's settings, scenes and Brightness Match
# live in macOS's preferences under this ID. scripts/release.sh refuses a signed build while it contains
# "prototype". See docs/release.md.
BUNDLE_ID=com.millerroberts.Glow

COPYRIGHT_HOLDER="Miller Roberts"
COPYRIGHT="© 2026 $COPYRIGHT_HOLDER"

# Where Glow points people: About's links. Resources/Info.plist holds placeholders on glow.example for
# the website, privacy policy and EULA when they are left empty. Support is an email address, a help
# page such as the issue tracker, or both; one is enough. Resources/Info.plist has no address, so an
# empty SUPPORT_EMAIL stays empty and About's Support link shows SUPPORT_URL's host. scripts/release.sh
# refuses a signed release until WEBSITE_URL, PRIVACY_POLICY_URL, EULA_URL, and SUPPORT_EMAIL or
# SUPPORT_URL are set. Glow never opens these itself: only when someone clicks one.
WEBSITE_URL=https://lineapps.vercel.app/glow/
SUPPORT_URL=https://github.com/millerroberts180/glow/issues
SUPPORT_EMAIL=
PRIVACY_POLICY_URL=https://github.com/millerroberts180/glow/blob/main/docs/legal/privacy-policy.md
EULA_URL=https://github.com/millerroberts180/glow/blob/main/docs/legal/EULA.txt
